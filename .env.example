# ====================================================================
# SmartLearn Compiler - Environment Variables Template
# ====================================================================
# Copy this file to '.env' and fill in your API credentials.
# Vite requires client-accessible variables to be prefixed with 'VITE_'

# --------------------------------------------------------------------
# 1. Google Gemini AI API Key
# --------------------------------------------------------------------
# Used for real-time AI Mentor Socratic explanations and hint generation.
# Get your free key at: https://aistudio.google.com/app/apikey
# If left blank, SmartLearn uses its built-in offline pedagogical engine.
VITE_GEMINI_API_KEY=

# --------------------------------------------------------------------
# 2. Supabase Integration (Auth, Database, Realtime)
# --------------------------------------------------------------------
# Enables cloud synchronization of mistake history, coding streak,
# and authentication across multiple devices.
# Get your keys at: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------------------
# 3. Judge0 Code Execution API (Optional)
# --------------------------------------------------------------------
# Enables live server-side compilation for C, C++, Java, Rust, Go, etc.
# RapidAPI Host: https://judge0-ce.p.rapidapi.com
# If left blank, SmartLearn uses its built-in intelligent multi-language sandbox.
VITE_JUDGE0_URL=https://judge0-ce.p.rapidapi.com
VITE_JUDGE0_API_KEY=
